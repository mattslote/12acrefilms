{
  "name": "12acrefilms",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "send_email": [
    { "name": "EMAIL", "destination_address": "matt@12acrefilms.com" }
  ],
  "vars": {
    "TO_ADDRESS": "matt@12acrefilms.com",
    "FROM_ADDRESS": "website@pxlstream.com"
  }
}
