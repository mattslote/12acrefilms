---
import Base from '../layouts/Base.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import ServiceAreas from './ServiceAreas.astro';
import { bySlug } from '../data/services';

const { s, parent = { label: 'Services', href: '/services' } } = Astro.props;
const url = `https://www.12acrefilms.com/${s.slug}`;

// Turn [text](/path) into links. Content is authored here, not user-supplied.
const inline = (t: string) => t.replace(/\[([^\]]+)\]\(((?:\/|https:\/\/)[^)]*)\)/g, '<a href="$2">$1</a>');

const related = s.related.map((r) => bySlug[r]).filter(Boolean);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: s.name,
    serviceType: s.name,
    url,
    provider: { '@type': 'LocalBusiness', name: '12 Acre Films', url: 'https://www.12acrefilms.com', telephone: '509.339.5227', email: 'matt@12acrefilms.com' },
    areaServed: ['Spokane, WA', 'Spokane Valley, WA', "Coeur d'Alene, ID", 'Pullman, WA', 'Tri-Cities, WA', 'Yakima, WA', 'Missoula, MT'],
    description: s.description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: s.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.12acrefilms.com/' },
      { '@type': 'ListItem', position: 2, name: parent.label, item: `https://www.12acrefilms.com${parent.href}` },
      { '@type': 'ListItem', position: 3, name: s.name, item: url },
    ],
  },
];
---
<Base title={s.metaTitle} description={s.description} schema={schema}>
  <Breadcrumbs trail={[{ label: 'Home', href: '/' }, { label: parent.label, href: parent.href }, { label: s.name }]} />

  <section class="hero" style="padding-top:70px">
    <div class="wrap">
      <p class="eyebrow">{s.eyebrow}</p>
      <h1>{s.h1}</h1>
      <p class="lead">{s.lead}</p>
      <div class="actions">
        {s.gentle
          ? <a class="btn" href="tel:+15093395227">Call 509.339.5227</a>
          : <a class="btn" href="/contact">{s.cta}</a>}
        {s.gentle
          ? <a class="btn ghost" href="/contact">{s.cta}</a>
          : <a class="btn ghost" href="#faq">Common questions</a>}
      </div>
    </div>
  </section>

  <section style="padding-top:88px">
    <div class="wrap narrow prose">
      {s.sections.map((sec, i) => (
        <div style={i > 0 ? 'margin-top:48px' : ''}>
          <h2>{sec.h2}</h2>
          {sec.paras?.map((p) => <p set:html={inline(p)} />)}
          {sec.bullets && <ul>{sec.bullets.map((b) => <li set:html={inline(b)} />)}</ul>}
        </div>
      ))}

      <div style="margin-top:48px">
        <h2>Where we work</h2>
        <ServiceAreas service={s.name.toLowerCase()} simple />
      </div>
    </div>
  </section>

  <section id="faq" style="background:var(--surface);border-block:1px solid var(--line)">
    <div class="wrap narrow">
      <h2>Frequently asked questions</h2>
      {s.faqs.map((f) => (
        <details style="border-bottom:1px solid var(--line);padding:14px 0">
          <summary style="cursor:pointer;font-weight:600">{f.q}</summary>
          <p class="muted" style="margin:10px 0 0">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2>Related services</h2>
      <div class="grid cols-3">
        {related.map((r) => (
          <a class="card" href={`/${r.slug}`} style="text-decoration:none">
            <div class="body">
              <h3>{r.name}</h3>
              <p class="muted" style="margin:0">{r.short}</p>
            </div>
          </a>
        ))}
      </div>
      <p style="margin-top:28px" class="muted">
        See also: <a href="/services">all services</a> · <a href="/work">portfolio</a> · <a href="/documentary">documentary</a> · <a href="/gear-list">gear list</a> · <a href="/about">about Matt</a> · <a href="/contact">contact</a>
      </p>
    </div>
  </section>

</Base>
