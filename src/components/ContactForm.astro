<form class="contact" novalidate>
        <div class="row">
          <label>Name *<input name="name" required autocomplete="name" /></label>
          <label>Email *<input name="email" type="email" required autocomplete="email" /></label>
        </div>
        <div class="row">
          <label>Phone<input name="phone" type="tel" autocomplete="tel" /></label>
          <label>Company / organization<input name="company" autocomplete="organization" /></label>
        </div>
        <div class="row">
          <label>Project type
            <select name="projectType">
              <option value="">Select…</option>
              <option>Commercial / brand video</option>
              <option>TV or web commercial</option>
              <option>Radio / audio ad</option>
              <option>Podcast</option>
              <option>Aerial / drone video</option>
              <option>Digitizing: VHS, photos, slides, film, DVD/CD</option>
              <option>Teleprompter operator</option>
              <option>Funeral / memorial live stream</option>
              <option>Documentary</option>
              <option>Live event</option>
              <option>Social media content</option>
              <option>Nonprofit / fundraising video</option>
              <option>Gear rental</option>
              <option>Something else</option>
            </select>
          </label>
          <label>Budget range
            <select name="budget">
              <option value="">Not sure yet</option>
              <option>Under $2,500</option>
              <option>$2,500 – $5,000</option>
              <option>$5,000 – $10,000</option>
              <option>$10,000 – $25,000</option>
              <option>$25,000+</option>
            </select>
          </label>
        </div>
        <label>Timeline<input name="timeline" placeholder="e.g. need final delivery by March" /></label>
        <label>Tell me about your project *<textarea name="message" required></textarea></label>

        <div class="hp" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off" /></label></div>

        <div  class="status" role="status" aria-live="polite"></div>
        <div><button class="btn" type="submit" >Send message</button></div>
</form>
