---
import ContactForm from './ContactForm.astro';
---
<dialog id="contact-modal" aria-labelledby="contact-modal-title">
  <button type="button" class="modal-close" aria-label="Close contact form">&times;</button>
  <h2 id="contact-modal-title">Tell me about your project</h2>
  <p class="muted">Fill this out and I'll get back to you soon. Or call <a href="tel:+15093395227">509.339.5227</a>.</p>
  <ContactForm />
</dialog>
<script>
  const modal = document.getElementById('contact-modal') as HTMLDialogElement | null;
  const w = window as any;
  let tsLoading = false;

  function loadTurnstile(cb: () => void) {
    if (w.turnstile) return cb();
    if (!tsLoading) {
      tsLoading = true;
      const s = document.createElement('script');
      s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
      s.async = true;
      s.onload = () => w.__tsReady?.forEach((f: () => void) => f());
      document.head.appendChild(s);
    }
    (w.__tsReady = w.__tsReady || []).push(cb);
  }
  function renderSlot(slot: HTMLElement) {
    if (slot.dataset.rendered) return;
    loadTurnstile(() => {
      if (slot.dataset.rendered) return;
      slot.dataset.rendered = String(w.turnstile.render(slot, { sitekey: slot.dataset.sitekey, theme: 'light' }));
    });
  }

  // Inline page form (the /contact page) renders its widget right away.
  document.querySelectorAll<HTMLElement>('main .ts-slot').forEach(renderSlot);

  // Open the popup instead of navigating to /contact
  const onContactPage = location.pathname.replace(/\/$/, '') === '/contact';
  function open(e?: Event) {
    if (!modal || onContactPage) return;
    e?.preventDefault();
    if (!modal.open) modal.showModal();
    const slot = modal.querySelector<HTMLElement>('.ts-slot');
    if (slot) renderSlot(slot);
    modal.querySelector<HTMLInputElement>('input[name=name]')?.focus();
    w.track12?.('contact_modal_open');
  }
  document.addEventListener('click', (e) => {
    const t = (e.target as HTMLElement).closest('a[href="/contact"], .contact-open');
    if (t && !(e as MouseEvent).metaKey && !(e as MouseEvent).ctrlKey) open(e);
  });
  modal?.querySelector('.modal-close')?.addEventListener('click', () => modal.close());
  modal?.addEventListener('click', (e) => { if (e.target === modal) modal.close(); });

  // Submission (shared by modal and /contact page)
  document.querySelectorAll<HTMLFormElement>('form.contact').forEach((form) => {
    const status = form.querySelector('.status') as HTMLElement;
    const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.className = 'status';
      if (!form.checkValidity()) { form.reportValidity(); return; }
      const data: Record<string, any> = Object.fromEntries(new FormData(form));
      data.turnstileToken = String(data['cf-turnstile-response'] ?? '');
      delete data['cf-turnstile-response'];
      btn.disabled = true; btn.textContent = 'Sending…';
      try {
        const res = await fetch('/api/contact', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(data) });
        const out = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(out.error || 'Something went wrong.');
        form.reset();
        w.track12?.('generate_lead', { form: form.closest('dialog') ? 'contact_modal' : 'contact' });
        status.className = 'status ok';
        status.textContent = "Thanks! Your message is on its way. I'll get back to you soon.";
      } catch (err) {
        status.className = 'status err';
        status.textContent = (err as Error).message + ' You can also email matt@12acrefilms.com.';
      } finally {
        btn.disabled = false; btn.textContent = 'Send message';
        const slot = form.querySelector<HTMLElement>('.ts-slot');
        if (slot?.dataset.rendered && w.turnstile) w.turnstile.reset(slot.dataset.rendered);
      }
    });
  });
</script>
