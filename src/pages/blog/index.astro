---
import Base from '../../layouts/Base.astro';
import posts from '../../data/posts.json';
const sorted = [...posts].sort((a, b) => b.date.localeCompare(a.date));
const fmt = (d: string) => new Date(d + 'T12:00:00').toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Base title="Blog" description="Notes on video production and filmmaking from 12 Acre Films, a Spokane, WA video production company.">
  <section>
    <div class="wrap narrow">
      <p class="eyebrow">Blog</p>
      <h1>Notes from the edit bay</h1>
      <div style="margin-top:36px;display:grid;gap:22px">
        {sorted.map((p) => (
          <article class="card">
            {p.image && <img class="thumb" src={p.image} alt="" loading="lazy" />}
            <div class="body">
              <p class="muted" style="margin:0 0 4px;font-size:.85rem">{fmt(p.date)}</p>
              <h3 style="margin:0">
                {p.body.length > 0 ? <a href={`/blog/${p.slug}`} style="text-decoration:none">{p.title}</a> : p.title}
              </h3>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>
