---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { areas, areaRegions } from '../../data/areas';
import site from '../../data/site.json';
const schema = [{
  '@context': 'https://schema.org', '@type': 'ItemList', name: 'Areas served by 12 Acre Films',
  itemListElement: areas.map((a, i) => ({ '@type': 'ListItem', position: i + 1, name: `${a.name}, ${a.state}`, url: `https://www.12acrefilms.com/areas/${a.slug}` })),
}];
---
<Base title="Video Production Across the Inland Northwest" description="12 Acre Films provides video production, live streaming, and drone video from Spokane across the Inland Northwest, from Yakima to Missoula." schema={schema}>
  <Breadcrumbs trail={[{ label: 'Home', href: '/' }, { label: 'Areas we serve' }]} />
  <section class="hero" style="padding-top:70px">
    <div class="wrap">
      <p class="eyebrow">Service area</p>
      <h1>Video production across the Inland Northwest</h1>
      <p class="lead">Based in Spokane, 12 Acre Films serves cities from Yakima to Missoula, between the Canadian border and the Oregon line. Pick your city to see how we work there.</p>
    </div>
  </section>
  <section style="padding-top:88px">
    <div class="wrap">
      {areaRegions.map((r) => (
        <div style="margin-bottom:40px">
          <h2>{r}</h2>
          <div class="grid cols-3" style="margin-top:18px">
            {areas.filter((a) => a.region === r).map((a) => (
              <a class="card" href={`/areas/${a.slug}`} style="text-decoration:none">
                <div class="body">
                  <h3>{a.name}, {a.state}</h3>
                  <p class="muted" style="margin:0">{a.county}</p>
                </div>
              </a>
            ))}
          </div>
        </div>
      ))}
      <p class="muted">Don't see your town? <a href="/contact">Ask</a>. Smaller communities near any of these cities are within reach. Browse our <a href="/services">services</a> or call {site.phone}.</p>
    </div>
  </section>
</Base>
