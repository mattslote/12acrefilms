---
import Base from '../layouts/Base.astro';
import projects from '../data/projects.json';
import { services, audiences } from '../data/services';
import site from '../data/site.json';
// Accepts either a bare embed URL or a pasted <iframe ...> snippet.
const raw = ((site as any).showreelEmbed || '').trim();
const showreel = raw.includes('<iframe') ? (raw.match(/src=["']([^"']+)["']/)?.[1] ?? '') : raw;
const featured = projects.slice(0, 3);
const hero = (site as any).heroImage as string;
const heroVideo = ((site as any).heroVideo || '') as string;
const heroEmbed = ((site as any).heroEmbed || '') as string;
const intro = (site as any).introImage as string;
const bandImg = (site as any).bandImage as string;
const clients = [
  'Washington State Dept. of Health', 'U.S. FDA', 'Westat', 'Spokane Parks & Recreation', 'Spokane Arts',
  'Healing Lodge of the Seven Nations', "St. George's School", 'Eastern Washington University',
  'Community Colleges of Spokane', 'TEDx Spokane',
];
---
<Base>
  <section class="hero-home" style={`background-image:url('${hero}')`}>
    {heroEmbed && <iframe class="hero-embed" src={heroEmbed} title="12 Acre Films hero reel" allow="autoplay; fullscreen; picture-in-picture" referrerpolicy="strict-origin-when-cross-origin" tabindex="-1" aria-hidden="true" id="hero-embed"></iframe>}
    {!heroEmbed && heroVideo && <video src={heroVideo} poster={hero} autoplay muted loop playsinline preload="metadata"></video>}
    <div class="inner">
      <h1>12 Acre Films<small>Spokane Video Production &amp; Videography</small></h1>
      <p class="cats">Commercial | Documentary | Social Media</p>
    </div>
  </section>

  <section class="band-grey">
    <div class="wrap split">
      <img src={intro} alt="Interview subject sitting for a documentary-style portrait" loading="lazy" />
      <div>
        <h2>Creating quality content starts with a conversation</h2>
        <p>Call me old-school, but I prefer to start a client relationship by talking about you, your business, your goals, and how I can help you get there.</p>
        <p style="margin-top:24px"><a class="btn" href="/contact">Start a conversation</a></p>
      </div>
    </div>
  </section>

  {showreel && (
    <section>
      <div class="wrap">
        <p class="eyebrow">Showreel</p>
        <div style="position:relative;aspect-ratio:16/9;border-radius:var(--radius);overflow:hidden;border:1px solid var(--line);background:#000">
          <iframe src={showreel} title="12 Acre Films showreel" loading="lazy" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen style="position:absolute;inset:0;width:100%;height:100%;border:0"></iframe>
        </div>
      </div>
    </section>
  )}

  <section style="padding-top:0">
    <div class="wrap">
      <p class="eyebrow">Selected work</p>
      <div class="grid cols-3">
        {featured.map((p) => (
          <a class="card" href={`/work/${p.slug}`} style="text-decoration:none">
            <img class="thumb" src={p.image} alt={p.title} loading="lazy" />
            <div class="body">
              <span class="tag cat">{p.category}</span>
              <h3>{p.title}</h3>
              <p class="muted" style="margin:0">{p.summary}</p>
            </div>
          </a>
        ))}
      </div>
      <p style="margin-top:26px"><a href="/work">All work →</a></p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <p class="eyebrow">What I do</p>
      <h2>Video &amp; audio production for the Inland Northwest</h2>
      <div class="grid cols-3" style="margin-top:28px">
        {services.map((sv) => (
          <a class="card peek" href={`/${sv.slug}`} style="text-decoration:none">
            <div class="body">
              <h3>{sv.name}</h3>
              <div class="peek-more"><div><p class="muted" style="margin:0">{sv.short}</p></div></div>
            </div>
          </a>
        ))}
      </div>
      <p style="margin-top:26px"><a href="/services">All services →</a></p>

      <h3 style="margin-top:56px">Made for your kind of organization</h3>
      <div class="grid cols-3" style="margin-top:18px">
        {audiences.map((a) => (
          <a class="card peek" href={`/${a.slug}`} style="text-decoration:none">
            <div class="body">
              <h3>{a.name}</h3>
              <div class="peek-more"><div><p class="muted" style="margin:0">{a.short}</p></div></div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section style="background:var(--surface);border-block:1px solid var(--line)">
    <div class="wrap narrow">
      <p class="eyebrow">Step up your brand</p>
      <h2>Your digital first impression matters.</h2>
      <p class="muted">I'm not going to dance around it. I help you get the right images in front of the right eyes at the right time.</p>
    </div>
  </section>

  <section class="band-photo" style={`background-image:url('${bandImg}')`}>
    <div class="wrap">
      <h2>Let’s set off on the right foot.</h2>
      <a class="btn" href="/contact">Contact</a>
    </div>
  </section>

  <section>
    <div class="wrap narrow prose">
      <h2>Working with 12 Acre Films</h2>
      <p>When you hire 12 Acre Films, you're handing your project off to an actual person who cares about you and your goals. From start to finish, that means your goals, your brand, and your vision stay at the center of every decision, from the first conversation through final delivery.</p>
      <p>Matt takes the time to understand what you're actually trying to accomplish before any planning begins. Whether you're a small business owner who's never made a video before or a marketing director with a clear brief in hand, the process is built around you: your timeline, your audience, and the results you need.</p>
      <p>12 Acre Films is a Spokane, WA video production company specializing in commercial video, documentary filmmaking, live event, and social media content creation. Matt has been serving businesses, nonprofits, and organizations across Spokane, Eastern Washington, and the Pacific Northwest since 2015. He especially likes the challenge of taking a complicated concept or business and packaging a message for a broader audience, with professional production quality and without the big agency price tag.</p>
      <p>Based in Spokane, Washington, 12 Acre Films serves the Inland Empire, frequently traveling to Spokane Valley/Liberty Lake, Coeur d'Alene, Cheney, Moscow/Pullman, the Tri-Cities, Yakima, Missoula, and smaller communities throughout the area.</p>
    </div>
  </section>

  <section style="padding-top:0">
    <div class="wrap">
      <p class="eyebrow">Trusted by</p>
      <div class="clients">{clients.map((c) => <span>{c}</span>)}</div>
    </div>
  </section>

<script is:inline>
  // Show the first frame (poster) instantly; fade the live video in once the player has loaded and started.
  (function () {
    var f = document.getElementById('hero-embed');
    if (!f) return;
    var done = false;
    var show = function () { if (done) return; done = true; setTimeout(function () { f.classList.add('ready'); }, 1800); };
    f.addEventListener('load', show, { once: true });
    setTimeout(show, 6000); // safety net if the load event never fires
  })();
</script>
</Base>
