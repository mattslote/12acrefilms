---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { services, audiences, formats } from '../data/services';

const pick = (slugs: string[]) => slugs.map((x) => services.find((s) => s.slug === x)).filter(Boolean) as typeof services;
const documentary = { slug: 'documentary', name: 'Documentary Filmmaking', short: 'Story-driven documentary work for brands, nonprofits, and passion projects.' } as (typeof services)[number];
const groups = [
  { title: 'Video production', open: true, intro: 'Commercials, corporate, nonprofit, social, and documentary storytelling.', items: [...pick(['corporate-video-production', 'tv-commercial-production', 'nonprofit-fundraising-video', 'interview-testimonial-video', 'social-media-video']), documentary, ...pick(['aerial-drone-video'])] },
  { title: 'Live Streaming and Podcasting', open: true, intro: 'Multi-camera live production for events, services, and funerals, plus podcast recording and radio ads.', items: pick(['live-events', 'funeral-live-streaming', 'podcast-video-recording', 'radio-commercial-production']) },
  { title: 'Digitize your archival media', open: false, intro: 'Preserve VHS and U-matic tapes, photographs, slides, film, and discs as digital files.', items: formats },
  { title: 'Crew & gear', open: false, intro: 'Add a teleprompter operator or rent the gear we use on real shoots.', items: pick(['teleprompter-operator', 'gear-rental']) },
  { title: 'Who we work with', open: false, intro: 'Every organization needs something different. These pages explain how we work with each.', items: audiences },
];
const schema = [{
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: '12 Acre Films services',
  itemListElement: [...services, ...audiences, ...formats].map((s, i) => ({
    '@type': 'ListItem', position: i + 1, name: s.name, url: `https://www.12acrefilms.com/${s.slug}`,
  })),
}];
---
<Base
  title="Video Production Services in Spokane, WA"
  description="Spokane video production: commercial, corporate and nonprofit video, live and funeral streaming, podcasts, radio ads, teleprompter operator and gear rental."
  schema={schema}
>
  <Breadcrumbs trail={[{ label: 'Home', href: '/' }, { label: 'Services' }]} />
  <section>
    <div class="wrap">
      <p class="eyebrow">Services</p>
      <h1>Video &amp; audio production services in Spokane</h1>
      <p class="muted" style="max-width:680px">From live streams and funerals to commercials, podcasts, and radio, 12 Acre Films helps businesses, nonprofits, families, and organizations across the Inland Northwest tell their story.</p>
      <div class="svc-groups">
        {groups.map((g) => (
          <details class="svc-group" open={g.open}>
            <summary><span>{g.title}</span><small>{g.items.length}</small></summary>
            <p class="muted svc-intro">{g.intro}</p>
            <div class="grid cols-3">
              {g.items.map((s) => (
                <a class="card" href={`/${s.slug}`} style="text-decoration:none">
                  <div class="body">
                    <h3>{s.name}</h3>
                    <p class="muted" style="margin:0 0 10px">{s.short}</p>
                    <span style="color:var(--accent)">Learn more →</span>
                  </div>
                </a>
              ))}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>
</Base>
<style>
  .svc-groups { margin-top: 36px; display: grid; gap: 14px; }
  .svc-group { border: 1px solid var(--line, #2a2a2a); border-radius: 10px; padding: 0 20px; }
  .svc-group summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; padding: 18px 0; font-size: 1.25rem; font-weight: 600; }
  .svc-group summary::-webkit-details-marker { display: none; }
  .svc-group summary small { font-size: .8rem; font-weight: 500; opacity: .6; margin-left: auto; margin-right: 14px; }
  .svc-group summary::after { content: '+'; font-size: 1.5rem; line-height: 1; color: var(--accent); }
  .svc-group[open] summary::after { content: '–'; }
  .svc-group .svc-intro { margin: 0 0 20px; max-width: 680px; }
  .svc-group .grid { padding-bottom: 24px; }
</style>
