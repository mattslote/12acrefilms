---
import Base from '../../layouts/Base.astro';
import projects from '../../data/projects.json';
import { dims } from '../../lib/imgDims';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;
const url = `https://www.12acrefilms.com/work/${p.slug}`;
// Some summaries are one short line; pad to a useful snippet length.
const description = p.summary.length < 110 ? `${p.summary} Video production by 12 Acre Films in Spokane, WA.` : p.summary;
const embed = p.muxEmbed || p.framerateEmbed;
const schema: object[] = [
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.12acrefilms.com/' },
      { '@type': 'ListItem', position: 2, name: 'Work', item: 'https://www.12acrefilms.com/work' },
      { '@type': 'ListItem', position: 3, name: p.title, item: url },
    ],
  },
];
// VideoObject needs an upload date to qualify for Google video results, so it is emitted only when a project has one.
// To enable: add "uploadDate": "YYYY-MM-DD" to the project in src/data/projects.json.
if (embed && (p as any).uploadDate) {
  schema.push({
    '@context': 'https://schema.org', '@type': 'VideoObject',
    name: p.title, description, thumbnailUrl: p.image, uploadDate: (p as any).uploadDate,
    embedUrl: embed, publisher: { '@id': 'https://www.12acrefilms.com/#business' },
  });
}
---
<Base title={(p as any).seoTitle ?? p.title} description={description} image={p.image} schema={schema}>
  <section>
    <div class="wrap narrow">
      <p class="eyebrow"><a href="/work" style="text-decoration:none">← Work</a></p>
      <h1>{p.title}</h1>
      <p>
        <span class="tag cat">{p.category}</span>
        {p.tags.map((t) => <span class="tag">{t}</span>)}
        {p.client && p.client !== 'Independent' && <span class="tag">{p.client}</span>}
      </p>

      {(p.muxEmbed || p.framerateEmbed) ? (
        <div style="position:relative;aspect-ratio:16/9;margin:28px 0;border-radius:10px;overflow:hidden;background:#000">
          <iframe src={p.muxEmbed || p.framerateEmbed} title={p.title} loading="lazy" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen
            style="position:absolute;inset:0;width:100%;height:100%;border:0"></iframe>
        </div>
      ) : (
        <img src={p.image} alt={p.title} {...dims(p.image)} fetchpriority="high" decoding="async" style="border-radius:10px;margin:28px 0" />
      )}

      <p class="muted" style="font-size:1.1rem">{p.summary}</p>
      {!(p.muxEmbed || p.framerateEmbed) && p.watchUrl && <p><a class="btn" href={p.watchUrl} rel="noopener">Watch</a></p>}
      <p style="margin-top:36px"><a class="btn ghost" href="/contact">Start your project</a></p>
    </div>
  </section>
</Base>
