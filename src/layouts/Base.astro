---
import '../styles/global.css';
import site from '../data/site.json';
import Header from '../components/Header.astro';
import ContactModal from '../components/ContactModal.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  schema?: object[];
  ogType?: 'website' | 'article';
  publishedTime?: string;
  noindex?: boolean;
}
const { title, description = site.description, image, imageAlt, schema = [], ogType = 'website', publishedTime, noindex = false } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | Spokane Videographer & Video Production Company`;
// build.format is 'file', so Astro.url.pathname can end in .html; the live URLs don't.
const cleanPath = Astro.url.pathname.replace(/(^|\/)index\.html$/, '/').replace(/\.html$/, '');
const canonical = new URL(cleanPath || '/', Astro.site).href;

// Social previews need an absolute image URL; fall back to the hero still when a page has none.
const abs = (u?: string) => (u ? new URL(u, Astro.site).href : undefined);
const ogImage = abs(image) ?? abs(site.heroImage);
const ogImageAlt = imageAlt ?? (title ? title : `${site.name}: ${site.tagline}`);
const robots = noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1';

const ld = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': 'https://www.12acrefilms.com/#business',
  name: site.name,
  description: site.description,
  url: 'https://www.12acrefilms.com/',
  logo: abs(site.logo),
  image: abs(site.heroImage),
  foundingDate: '2016',
  founder: { '@type': 'Person', name: 'Matt Slotemaker' },
  telephone: site.phone,
  email: site.email,
  areaServed: ['Spokane', 'Spokane Valley', 'Liberty Lake', "Coeur d'Alene", 'Cheney', 'Pullman', 'Moscow', 'Tri-Cities', 'Yakima', 'Missoula'],
  address: { '@type': 'PostalAddress', addressLocality: 'Spokane', addressRegion: 'WA', addressCountry: 'US' },
  sameAs: [site.instagram, site.facebook],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#111111" />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    <slot name="head" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Non-blocking font CSS: system-ui text paints immediately, Poppins swaps in. -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript><link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" /></noscript>
    <Analytics />
  </head>
  <body style={`--hero-img:url('${site.heroImage}')`} class={['/', '/index', '/index.html'].includes(Astro.url.pathname) ? 'home' : undefined}>
    <a class="skip" href="#main">Skip to content</a>
    <Header current={Astro.url.pathname} />
    <main id="main"><slot /></main>
    {!['/contact','/404'].includes(Astro.url.pathname.replace(/\/$/, '')) && (
      <section class="bottom-cta">
        <div class="wrap narrow">
          <h2>Ready to talk about your project?</h2>
          <p class="muted">Tell me what you are trying to accomplish and I will get back to you.</p>
          <button type="button" class="btn contact-open">Contact us</button>
        </div>
      </section>
    )}
    <Footer />
    <ContactModal />
  </body>
</html>
